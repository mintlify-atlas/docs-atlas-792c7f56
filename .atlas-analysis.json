  "keyFeatures": [
    "Limine bootloader integration with framebuffer TTY and PSF1 font rendering",
    "Physical Memory Manager (PMM) with per-page reference counting",
    "Virtual Memory Manager (VMM) with 4-level paging and copy-on-write fork support",
    "Global Descriptor Table (GDT) and Interrupt Descriptor Table (IDT)",
    "APIC and I/O APIC interrupt controller support",
    "Multi-Level Feedback Queue (MLFQ) process scheduler",
    "Slab allocator (kmalloc/kfree) for kernel heap management",
    "ELF64 loader for user-space executables",
    "Initramfs (CPIO) filesystem with in-memory VFS",
    "Syscall interface via SYSCALL/SYSRET MSR: read, write, open, close, fork, execve, exit, wait, readdir",
    "Minimal userland libc (stdio, stdlib, string, unistd) with syscall wrappers",
    "Userland shell (sh) with fork+execve process spawning",
    "Keyboard driver wired to stdin (fd 0) with line-buffered blocking reads",
    "Serial driver for GDB debugging",
    "Unity-based unit tests for kernel subsystems"
  ],
  "publicApiSurface": [
    "SYS_read (0)", "SYS_write (1)", "SYS_open (2)", "SYS_close (3)",
